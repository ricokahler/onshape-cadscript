{
  "manifest_version": 3,
  "name": "Onshape CadScript Bridge",
  "version": "0.1.0",
  "description": "Connects local CadScript tools to the Onshape session already signed in to Chrome.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["nativeMessaging", "tabs"],
  "host_permissions": ["https://cad.onshape.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Onshape CadScript Bridge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://cad.onshape.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://cad.onshape.com/*"],
      "js": ["selection-adapter.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
